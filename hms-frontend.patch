diff --git a/scripts/run-api.ps1 b/scripts/run-api.ps1
new file mode 100644
index 0000000..f8f527c
--- /dev/null
+++ b/scripts/run-api.ps1
@@ -0,0 +1,12 @@
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+Set-Location $root
+if (-not (Get-Command javac -ErrorAction SilentlyContinue)) { throw 'javac not found. install a JDK and ensure javac is on PATH.' }
+New-Item -ItemType Directory -Force -Path 'out' | Out-Null
+$files = Get-ChildItem -Path 'src' -Recurse -Filter '*.java' | ForEach-Object { $_.FullName }
+if (-not $files) { throw 'no Java source files found under src' }
+Write-Host 'compiling existing Java classes and the new HTTP API...' -ForegroundColor Cyan
+& javac --add-modules jdk.httpserver -d out $files
+if ($LASTEXITCODE -ne 0) { throw 'compilation failed, see errors above' }
+Write-Host 'starting local API at http://127.0.0.1:8080/api' -ForegroundColor Green
+& java --add-modules jdk.httpserver -cp out api.HotelApi
diff --git a/scripts/run-frontend.ps1 b/scripts/run-frontend.ps1
new file mode 100644
index 0000000..3eb1f37
--- /dev/null
+++ b/scripts/run-frontend.ps1
@@ -0,0 +1,7 @@
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+$frontend = Join-Path $root 'frontend'
+Set-Location $frontend
+if (-not (Get-Command npm -ErrorAction SilentlyContinue)) { throw 'npm not found. install Node.js LTS first.' }
+if (-not (Test-Path 'node_modules')) { npm install; if ($LASTEXITCODE -ne 0) { throw 'npm install failed' } }
+npm run dev
diff --git a/scripts/apply-patch.ps1 b/scripts/apply-patch.ps1
new file mode 100644
index 0000000..20fafcd
--- /dev/null
+++ b/scripts/apply-patch.ps1
@@ -0,0 +1,13 @@
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+$patch = Join-Path $root 'hms-frontend.patch'
+Set-Location $root
+if (-not (Test-Path $patch)) { throw "patch not found at $patch, place hms-frontend.patch in the repository root first" }
+if (-not (Get-Command git -ErrorAction SilentlyContinue)) { throw 'git not found on PATH' }
